#!/bin/bash
set -e

# Resolve the checkout from this script, not the caller's working directory.
cd "$(dirname "${BASH_SOURCE[0]}")"
BUILD_ROOT=$(pwd -P)
INSTALL_ROOT="$BUILD_ROOT/install"
printf 'BUILD_ROOT=%s\nINSTALL_ROOT=%s\n' "$BUILD_ROOT" "$INSTALL_ROOT"
git rev-parse HEAD
cksum config_script

# To install Python2.6
# Currently Loaded Modules:
#   1) git/2.21.0      3) cmake/3.13.4   5) pmix/3.1.2      7) xalt/2.7.1   9) intel/18.0.5     11) impi/18.0.5
#   2) autotools/1.2   4) ucx/1.5.1      6) hwloc/1.11.12   8) TACC        10) libfabric/1.7.1  12) python2/2.7.16
# Use intel/18 instead of intel/19

export PATH=/work/ess-zhangkd/CitcomS/vendor/python2.6.9/bin:$PATH
export PATH=$PATH:$(pwd)
if command -v module >/dev/null 2>&1; then
    module load intel/2018.4 mpi/intel/2018.4
    module load hdf5/1.8.18-parallel-intel-18.4
fi

# Clean previous build
make distclean 2>/dev/null || true

# configure and Makefile.in must be generated by the same current toolchain.
# Merely finding an old configure is not sufficient after updating sources.
if ! command -v autoreconf >/dev/null 2>&1; then
    echo "ERROR: autoreconf is required; load the cluster Autotools environment." >&2
    exit 2
fi
autoreconf -fiv

# Keep installed files separate from in-tree build products (notably bin/).
./configure --prefix="$INSTALL_ROOT" --exec-prefix="$INSTALL_ROOT" \
      --bindir="$INSTALL_ROOT/bin" --with-hdf5="$HDF5ROOT" \
      CPPFLAGS="-I$HDF5ROOT/include -DH5_USE_16_API" \
        LDFLAGS="-L$HDF5ROOT/lib"

# A literal @AR@ becomes shell command AR@ because make consumes leading @.
# Fail here with the actual cause instead of after compiling every object.
if [ ! -s lib/Makefile ]; then
    echo "ERROR: configure did not generate lib/Makefile" >&2
    exit 2
fi
if grep -Eq '^[[:space:]]*(AR|RANLIB|CC|CXX)[[:space:]]*=[[:space:]]*@[^@]+@' lib/Makefile; then
    echo "ERROR: unresolved tool substitutions in lib/Makefile; check configure/config.status logs." >&2
    grep -E '^[[:space:]]*(AR|RANLIB|CC|CXX)[[:space:]]*=' lib/Makefile >&2
    exit 2
fi

[ -e aux-config/install-sh ] && chmod +x aux-config/install-sh
[ -e aux-config/py-compile ] && chmod +x aux-config/py-compile
if [ -f libtool ]; then
    perl -0pi -e 's/^ECHO=.*$/ECHO=echo/m; s/^echo=.*$/echo=echo/m; s/^objdir=.*$/objdir=.libs/m; if (!/^echo=/m) { s/^(ECHO=.*)$/$1\necho=echo/m; }' libtool
    chmod +x libtool
fi
if [ -f examples/Makefile ]; then
    perl -0pi -e 's|MKDIR_P = \@MKDIR_P\@|MKDIR_P = /bin/mkdir -p|g' examples/Makefile
fi

# Query the generated Makefile using make's actual variable precedence.
# Fail before compilation if stale configuration or environment overrides it.
make --no-print-directory -s -C bin -f Makefile -f - \
    P0_EXPECTED_BINDIR="$INSTALL_ROOT/bin" p0-check-install-path <<'P0_MAKE'
.PHONY: p0-check-install-path
p0-check-install-path:
	@printf 'Resolved prefix=%s exec_prefix=%s bindir=%s DESTDIR=%s\n' '$(prefix)' '$(exec_prefix)' '$(bindir)' '$(DESTDIR)'
	@test '$(bindir)' = '$(P0_EXPECTED_BINDIR)' && test -z '$(DESTDIR)' || { echo 'ERROR: installation path mismatch; inspect configure options and MAKEFLAGS/DESTDIR.' >&2; exit 1; }
P0_MAKE
make -j4
make install SUBDIRS="lib CitcomS etc bin module" \
    prefix="$INSTALL_ROOT" exec_prefix="$INSTALL_ROOT" bindir="$INSTALL_ROOT/bin"
test -x install/bin/CitcomSFull

