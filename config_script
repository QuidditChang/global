#!/bin/bash
set -eE -o pipefail
cd "$(dirname "$0")"
BUILD_PHASE=preflight
trap 'rc=$?; echo "BUILD_FAILED phase=${BUILD_PHASE} rc=${rc}" >&2; exit "$rc"' ERR
# A failed rebuild must not leave a usable receipt for an older executable.
rm -f frozen_current_build.json
unset PYTHONHOME
if [ -n "${STRICT_ALA_PYTHON:-}" ]; then
    PYTHON3=${STRICT_ALA_PYTHON}
elif [ -x /share/apps/anaconda3/2020.7/bin/python3 ]; then
    PYTHON3=/share/apps/anaconda3/2020.7/bin/python3
else
    PYTHON3=$(command -v python3)
fi
"${PYTHON3}" -c 'import sys; assert sys.version_info >= (3, 7)'

# To install Python2.6
# Currently Loaded Modules:
#   1) git/2.21.0      3) cmake/3.13.4   5) pmix/3.1.2      7) xalt/2.7.1   9) intel/18.0.5     11) impi/18.0.5
#   2) autotools/1.2   4) ucx/1.5.1      6) hwloc/1.11.12   8) TACC        10) libfabric/1.7.1  12) python2/2.7.16
# Use intel/18 instead of intel/19

export PATH=/work/ess-zhangkd/CitcomS/vendor/python2.6.9/bin:$PATH
export PATH=$PATH:$(pwd)
if command -v module >/dev/null 2>&1; then
    module load intel/2018.4 mpi/intel/2018.4
    module load hdf5/1.8.18-parallel-intel-18.4
fi

# Clean previous build
BUILD_PHASE=clean
make distclean 2>/dev/null || true

if [ ! -s ./configure ]; then
    autoreconf -fi
fi

BUILD_PHASE=configure
./configure --prefix="$(pwd)" --with-hdf5="${HDF5ROOT:?HDF5 module did not set HDF5ROOT}" \
      CPPFLAGS="-I$HDF5ROOT/include -DH5_USE_16_API" \
        LDFLAGS="-L$HDF5ROOT/lib"

# Existing configure files are not tracked and can survive git pull.
BUILD_PHASE=compatibility
"${PYTHON3}" tools/fix_generated_pyconfig.py pyconfig

[ -e aux-config/install-sh ] && chmod +x aux-config/install-sh
[ -e aux-config/py-compile ] && chmod +x aux-config/py-compile
if [ -f libtool ]; then
    perl -0pi -e 's/^ECHO=.*$/ECHO=echo/m; s/^echo=.*$/echo=echo/m; s/^objdir=.*$/objdir=.libs/m; if (!/^echo=/m) { s/^(ECHO=.*)$/$1\necho=echo/m; }' libtool
    chmod +x libtool
fi
if [ -f examples/Makefile ]; then
    perl -0pi -e 's|MKDIR_P = \@MKDIR_P\@|MKDIR_P = /bin/mkdir -p|g' examples/Makefile
fi

# Old Automake templates use mkdir_p; newer ones use MKDIR_P. Supply both
# explicitly so an empty configure substitution cannot execute a directory.
BUILD_PHASE=compile
make -j4 mkdir_p="/bin/mkdir -p" MKDIR_P="/bin/mkdir -p"
BUILD_PHASE=install
# Do not override SUBDIRS on the make command line: GNU make propagates it
# into module, replacing that directory's own optional Exchanger subdirectory.
for directory in lib CitcomS etc module; do
    make -C "${directory}" install \
        mkdir_p="/bin/mkdir -p" MKDIR_P="/bin/mkdir -p"
done
# prefix is the build root: compiled bin programs already occupy their final
# paths. Installing them again copies each file onto itself. The citcoms script
# still needs its install-time interpreter/PYTHONPATH substitutions.
make -C bin install-binSCRIPTS \
    mkdir_p="/bin/mkdir -p" MKDIR_P="/bin/mkdir -p"
for executable in CitcomSFull CitcomSRegional pycitcoms mpipycitcoms; do
    test -x "bin/${executable}"
done

BUILD_PHASE=receipt
"${PYTHON3}" tools/strict_ala_frozen_current.py stamp-build --code "$(pwd)"
echo "BUILD_COMPLETE: compiled, installed and stamped $(pwd)"

